# Default database is data/lol-data.db; no external database service is required.
# Optional MySQL: use a new schema matching the current models.
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/lol_data_v2
HOST=127.0.0.1
PORT=5100
SCHEDULE_TIME=08:00

# Optional AI assistant. Without a key, the site and analytics still work.
AI_API_KEY=
AI_BASE_URL=https://aiping.cn/api/v1
AI_MODEL=DeepSeek-V4.1-Flash
AI_MAX_TOKENS=2048
AI_TIMEOUT=45
